{
  "title": "Làm sạch đơn hàng Postgres",
  "table": "sales_raw.orders",
  "columns": [
    {"from": "order_id", "as": "order_id", "type": "integer"},
    {"from": "customer_id", "as": "customer_id", "type": "integer"},
    {"from": "amount_text", "as": "amount", "type": "decimal(18,2)"},
    {"from": "ordered_at_text", "as": "ordered_at", "type": "date"},
    {"from": "status", "as": "status", "type": "varchar"}
  ]
}
