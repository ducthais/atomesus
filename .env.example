# ============================================================================
# Atomesus — biến môi trường (một file .env duy nhất ở thư mục gốc)
# ============================================================================
# Copy thành .env rồi điền giá trị:   cp .env.example .env
# Phần Postgres nguồn tự sinh bằng:    python scripts/setup_pipeline.py
# KHÔNG commit .env. File này chỉ chứa placeholder.

# ---- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
# Model lập kế hoạch / viết Spec (mặc định gpt-4o-mini; để trống MODEL_NAME_STRONG thì dùng MODEL_NAME)
# MODEL_NAME=gpt-4o-mini
# MODEL_NAME_STRONG=

# ---- Ứng dụng ----------------------------------------------------------------
# development | test | production (production khóa đăng nhập bằng tài khoản local)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Postgres nguồn (docker compose --env-file .env ... và backend cùng đọc) -----
# setup_pipeline.py thay các giá trị replace-... bằng mật khẩu ngẫu nhiên.
# Mật khẩu reader phải trùng phần mật khẩu trong PIPELINE_DATABASE_URL (URL-encode nếu có ký tự đặc biệt).
POSTGRES_PASSWORD=replace-admin-password
PIPELINE_READER_PASSWORD=replace-reader-password
PIPELINE_DATABASE_URL=postgresql://pipeline_reader:replace-reader-password@127.0.0.1:5433/pipeline_demo

# ---- Pipeline (tùy chọn; bỏ trống dùng mặc định trong src/pipeline/settings.py) ----
# Mật khẩu hai tài khoản local (mặc định Engineer@123 / Reviewer@123). Đổi khi chia sẻ môi trường.
# PIPELINE_ENGINEER_PASSWORD=
# PIPELINE_REVIEWER_PASSWORD=
# Múi giờ DuckDB khi chạy thử, phải là UTC; đặt khác chỉ để tái hiện lỗi lệch giờ trong demo.
# PIPELINE_WAREHOUSE_TIMEZONE=UTC
# PIPELINE_DAGSTER_URL=http://127.0.0.1:3070
# Nguồn rest_api (connection_ref mock_api): chạy `make mock-api` trước khi dùng sales_api / mkt_api.
# PIPELINE_MOCK_API_URL=http://127.0.0.1:8100
# Cổng budget dùng dry_run thật của BigQuery (pip install google-cloud-bigquery; xác thực bằng
# `gcloud auth application-default login`). Dataset chứa bản sao các bảng nguồn Postgres, cùng tên bảng.
# PIPELINE_BIGQUERY_PROJECT=
# PIPELINE_BIGQUERY_DATASET=

# ---- Vector store (Sprint 4) ---------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma

# ---- LangSmith (tùy chọn) ----------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=atomesus

# ---- Ghi log AI (khóa do giảng viên cấp, mỗi thành viên một khóa) ---------------
AI_LOG_SERVER=https://your-ai-log-server
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log
