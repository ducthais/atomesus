{
  "spec_version": "1.2",
  "domain": "sales",
  "sources": [
    {
      "id": "orders",
      "kind": "postgres",
      "source_ref": "sales_pg",
      "table": "orders",
      "primary_key": ["order_id"],
      "cursor_field": null,
      "write_disposition": "replace",
      "target": { "dataset": "bronze", "table": "raw_orders" },
      "staging": {
        "columns": [
          { "from": "order_id",        "as": "order_id",    "type": "bigint" },
          { "from": "customer_id",     "as": "customer_id", "type": "bigint" },
          { "from": "amount_text",     "as": "amount_vnd",  "type": "decimal(18,2)" },
          { "from": "ordered_at_text", "as": "order_date",  "type": "date",
            "date_formats": ["%Y-%m-%d", "%d/%m/%Y", "%Y/%m/%d"] },
          { "from": "status",          "as": "status",      "type": "varchar" }
        ],
        "dedupe": { "keys": ["order_id"], "keep": "first", "order_by": "order_id" },
        "reject_if": ["order_id IS NULL", "amount_vnd < 0"]
      }
    }
  ],
  "transform": {
    "model_name": "fct_daily_orders",
    "from": "orders",
    "joins": [],
    "materialization": "table",
    "unique_key": ["order_date"],
    "grain": ["order_date"],
    "metrics": [
      { "name": "revenue", "expr": "SUM(amount_vnd)" },
      { "name": "order_count", "expr": "COUNT(DISTINCT order_id)" }
    ],
    "filters": ["status <> 'cancelled'"],
    "partition_by": "order_date",
    "tests": [
      { "column": "order_date", "test": "not_null" },
      { "column": "order_date", "test": "unique" },
      { "column": "revenue", "test": "not_negative" }
    ]
  },
  "schedule": { "cron": "0 2 * * *" },
  "estimates": { "bytes_scanned": 0, "usd": 0.0, "latency_sec": 0 }
}
