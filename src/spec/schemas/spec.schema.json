{
  "$defs": {
    "ColumnTest": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Column",
          "type": "string"
        },
        "test": {
          "enum": [
            "not_null",
            "unique",
            "not_negative"
          ],
          "title": "Test",
          "type": "string"
        }
      },
      "required": [
        "column",
        "test"
      ],
      "title": "ColumnTest",
      "type": "object"
    },
    "CurrencyRule": {
      "additionalProperties": false,
      "properties": {
        "code_column": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Code Column",
          "type": "string"
        },
        "to": {
          "maxLength": 3,
          "minLength": 3,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "code_column",
        "to"
      ],
      "title": "CurrencyRule",
      "type": "object"
    },
    "Dedupe": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keys"
        },
        "keep": {
          "enum": [
            "latest",
            "first"
          ],
          "title": "Keep",
          "type": "string"
        },
        "order_by": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Order By",
          "type": "string"
        }
      },
      "required": [
        "keep",
        "order_by"
      ],
      "title": "Dedupe",
      "type": "object"
    },
    "Estimates": {
      "additionalProperties": false,
      "properties": {
        "bytes_scanned": {
          "minimum": 0,
          "title": "Bytes Scanned",
          "type": "integer"
        },
        "usd": {
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        },
        "latency_sec": {
          "minimum": 0,
          "title": "Latency Sec",
          "type": "number"
        }
      },
      "required": [
        "bytes_scanned",
        "usd",
        "latency_sec"
      ],
      "title": "Estimates",
      "type": "object"
    },
    "FilesystemSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "source_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Source Ref",
          "type": "string"
        },
        "primary_key": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "type": "string"
          },
          "title": "Primary Key",
          "type": "array"
        },
        "cursor_field": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor Field"
        },
        "write_disposition": {
          "enum": [
            "append",
            "replace",
            "merge"
          ],
          "title": "Write Disposition",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "staging": {
          "$ref": "#/$defs/Staging"
        },
        "kind": {
          "const": "filesystem",
          "title": "Kind",
          "type": "string"
        },
        "path_pattern": {
          "minLength": 1,
          "title": "Path Pattern",
          "type": "string"
        },
        "format": {
          "enum": [
            "csv",
            "parquet",
            "jsonl"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_ref",
        "write_disposition",
        "target",
        "staging",
        "kind",
        "path_pattern",
        "format"
      ],
      "title": "FilesystemSource",
      "type": "object"
    },
    "Join": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Source",
          "type": "string"
        },
        "type": {
          "enum": [
            "inner",
            "left"
          ],
          "title": "Type",
          "type": "string"
        },
        "on": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "On",
          "type": "array"
        }
      },
      "required": [
        "source",
        "type",
        "on"
      ],
      "title": "Join",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "expr": {
          "minLength": 1,
          "title": "Expr",
          "type": "string"
        }
      },
      "required": [
        "name",
        "expr"
      ],
      "title": "Metric",
      "type": "object"
    },
    "PostgresSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "source_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Source Ref",
          "type": "string"
        },
        "primary_key": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "type": "string"
          },
          "title": "Primary Key",
          "type": "array"
        },
        "cursor_field": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor Field"
        },
        "write_disposition": {
          "enum": [
            "append",
            "replace",
            "merge"
          ],
          "title": "Write Disposition",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "staging": {
          "$ref": "#/$defs/Staging"
        },
        "kind": {
          "const": "postgres",
          "title": "Kind",
          "type": "string"
        },
        "table": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_ref",
        "write_disposition",
        "target",
        "staging",
        "kind",
        "table"
      ],
      "title": "PostgresSource",
      "type": "object"
    },
    "RestApiSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "source_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Source Ref",
          "type": "string"
        },
        "primary_key": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "type": "string"
          },
          "title": "Primary Key",
          "type": "array"
        },
        "cursor_field": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor Field"
        },
        "write_disposition": {
          "enum": [
            "append",
            "replace",
            "merge"
          ],
          "title": "Write Disposition",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "staging": {
          "$ref": "#/$defs/Staging"
        },
        "kind": {
          "const": "rest_api",
          "title": "Kind",
          "type": "string"
        },
        "endpoint": {
          "pattern": "^/\\S*$",
          "title": "Endpoint",
          "type": "string"
        },
        "records_path": {
          "minLength": 1,
          "title": "Records Path",
          "type": "string"
        },
        "pagination": {
          "enum": [
            "page",
            "offset",
            "cursor",
            "none"
          ],
          "title": "Pagination",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_ref",
        "write_disposition",
        "target",
        "staging",
        "kind",
        "endpoint",
        "records_path",
        "pagination"
      ],
      "title": "RestApiSource",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "properties": {
        "cron": {
          "pattern": "^\\S+( \\S+){4}$",
          "title": "Cron",
          "type": "string"
        }
      },
      "required": [
        "cron"
      ],
      "title": "Schedule",
      "type": "object"
    },
    "Staging": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/StagingColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "dedupe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dedupe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reject_if": {
          "items": {
            "type": "string"
          },
          "title": "Reject If",
          "type": "array"
        }
      },
      "required": [
        "columns"
      ],
      "title": "Staging",
      "type": "object"
    },
    "StagingColumn": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "From",
          "type": "string"
        },
        "as": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "As",
          "type": "string"
        },
        "type": {
          "pattern": "^(bigint|integer|double|varchar|boolean|date|timestamp|decimal\\(\\d{1,2},\\d{1,2}\\))$",
          "title": "Type",
          "type": "string"
        },
        "date_formats": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Formats"
        },
        "currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrencyRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "from",
        "as",
        "type"
      ],
      "title": "StagingColumn",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "const": "bronze",
          "title": "Dataset",
          "type": "string"
        },
        "table": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "table"
      ],
      "title": "Target",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "model_name": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Model Name",
          "type": "string"
        },
        "from": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "From",
          "type": "string"
        },
        "joins": {
          "items": {
            "$ref": "#/$defs/Join"
          },
          "title": "Joins",
          "type": "array"
        },
        "materialization": {
          "enum": [
            "view",
            "table",
            "incremental"
          ],
          "title": "Materialization",
          "type": "string"
        },
        "unique_key": {
          "items": {
            "type": "string"
          },
          "title": "Unique Key",
          "type": "array"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Grain",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "partition_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition By"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/ColumnTest"
          },
          "title": "Tests",
          "type": "array"
        }
      },
      "required": [
        "model_name",
        "from",
        "materialization",
        "grain",
        "metrics"
      ],
      "title": "Transform",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "1.2",
      "title": "Spec Version",
      "type": "string"
    },
    "domain": {
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "title": "Domain",
      "type": "string"
    },
    "sources": {
      "items": {
        "discriminator": {
          "mapping": {
            "filesystem": "#/$defs/FilesystemSource",
            "postgres": "#/$defs/PostgresSource",
            "rest_api": "#/$defs/RestApiSource"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/PostgresSource"
          },
          {
            "$ref": "#/$defs/RestApiSource"
          },
          {
            "$ref": "#/$defs/FilesystemSource"
          }
        ]
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "transform": {
      "$ref": "#/$defs/Transform"
    },
    "schedule": {
      "$ref": "#/$defs/Schedule"
    },
    "estimates": {
      "$ref": "#/$defs/Estimates"
    }
  },
  "required": [
    "spec_version",
    "domain",
    "sources",
    "transform",
    "schedule",
    "estimates"
  ],
  "title": "Spec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Sinh tự động từ src/spec/models.py. Ràng buộc chéo giữa các trường chỉ có ở model."
}
